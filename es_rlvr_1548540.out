  q = sp.Sum(1/sp.symbols('k')**3, (sp.symbols('k'), 1, sp.oo)).doit()
  
  # Calculate the double sum
  double_sum = sp.Sum((sp.symbols('n')-1)/sp.symbols('n')**3, (sp.symbols('n'), 2, sp.oo)).doit()
  
  # Simplify the double sum
  double_sum_simplified = sp.simplify(double_sum)
  
  # Print the result
  print(double_sum_simplified)
