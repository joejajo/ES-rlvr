  # Rectangular coordinates
  x = 0
  y = 3
  
  # Calculate the radius r
  r = math.sqrt(x**2 + y**2)
  
  # Calculate the angle theta
  theta = math.atan2(y, x)
  
  # Since atan2(y, x) returns the angle in the correct quadrant, we need to ensure it's in the range [0, 2*pi)
  if theta < 0:
      theta += 2 * math.pi
  
  print(((r, theta)))
  ```
